root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
max_line_length = 88

[*.toml]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false
