# Copy to app/.env if you need to change anything. app/.env is git-ignored;
# never commit a real key.

# Backend: "cli" uses the logged-in Claude Code (subscription, no key).
# "api" uses ANTHROPIC_API_KEY (billed per token). Default: api if a key is set, else cli.
# WIKI_CHAT_BACKEND=cli

# ANTHROPIC_API_KEY=

# Optional overrides. Empty model on cli = Claude Code's configured default.
# WIKI_CHAT_MODEL=claude-opus-5-5
# WIKI_CHAT_EFFORT=medium
